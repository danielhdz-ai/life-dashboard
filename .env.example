# Supabase (proyecto life-dashboard existente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (solo servidor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OAuth correo (solo servidor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Cifrado tokens email (32 bytes en base64 o hex — generar de forma segura)
TOKEN_ENCRYPTION_KEY=

# Cron Vercel
CRON_SECRET=

# Auth: único usuario permitido
ALLOWED_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integraciones opcionales
ENABLE_STRIPE_CONNECT=false
STRIPE_SECRET_KEY=
